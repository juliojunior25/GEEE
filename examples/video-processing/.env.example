# GEEE Video Analysis Pipeline - Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#

# Google Geocoding API Key (Optional)
# Get your API key at: https://console.cloud.google.com/
# This is used by the geocoding-enricher plugin to convert location names to GPS coordinates.
# The plugin is marked as optional, so the pipeline will succeed even without this key.
#
# Free tier: $200/month credit (~40,000 requests)
# Cost: $5 per 1,000 requests after free tier
#
GOOGLE_GEOCODING_API_KEY=

# LLM Server Configuration (Optional)
# The default llama.cpp server runs on localhost:8080
# Change these if you're running the server on a different host/port
#
# LLM_ENDPOINT=http://localhost:8080/completion

# Whisper Model Selection (Optional)
# Override the default Whisper model (base) by uncommenting:
# Options: tiny, base, small, medium, large
#   - tiny: Fastest, lowest accuracy (~39MB)
#   - base: Balanced (default) (~74MB)
#   - small: Better accuracy (~244MB)
#   - medium: High accuracy (~769MB)
#   - large: Best accuracy, slowest (~1550MB)
#
# WHISPER_MODEL=base

# Video Download Quality (Optional)
# Override default quality setting
# Options: best, worst, 720p, 480p, 360p, etc.
#
# VIDEO_QUALITY=best

# Pipeline Timeout (Optional)
# Override default timeout of 300 seconds (5 minutes)
# Increase for longer videos or slower hardware
#
# PIPELINE_TIMEOUT=600

# Additional Notes:
#
# 1. Environment variables can be used in pipeline.yaml with ${VAR_NAME} syntax
#
# 2. For security, never commit the .env file to version control
#    (it's already in .gitignore)
#
# 3. To test without geocoding:
#    - Leave GOOGLE_GEOCODING_API_KEY empty
#    - The pipeline will skip location enrichment but complete successfully
#
# 4. To use a different LLM server:
#    - Update LLM_ENDPOINT to point to your server
#    - Ensure the server supports the llama.cpp completion API format
